# Streamlit Secrets Configuration
# Copy this file to .streamlit/secrets.toml and fill in your values
# DO NOT commit secrets.toml to git!

# OpenRouter API key (FREE Gemini access) - Get yours at https://openrouter.ai/keys
OPENROUTER_API_KEY = "sk-or-v1-your-key-here"

# Claude API key (PAID) - Optional, only if you want to use Claude
# ANTHROPIC_API_KEY = "sk-ant-your-api-key-here"

# Optional authentication
# AUTH_ENABLED = true
# [USERS]
# admin = "your-password"
